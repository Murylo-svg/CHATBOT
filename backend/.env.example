# ==========================================================
#  Backend do Agente de IA — copie para .env e preencha
#  O .env NUNCA vai para o GitHub.
# ==========================================================

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development

# ---------- Banco de Dados (MongoDB Atlas) ----------
# mongodb+srv://usuario:senha@cluster.mongodb.net/agente-ia?retryWrites=true&w=majority
MONGO_URI=

# ---------- Autenticacao (JWT) ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- IA Generativa (Google Gemini) ----------
# Chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.0-flash

# ---------- Upload de Imagens (Cloudinary) ----------
# Copie o "API Environment variable" do painel do Cloudinary:
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Alternativa em variaveis separadas (use uma abordagem OU a outra):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---------- Clima (Function Calling) ----------
# Usamos a Open-Meteo, que NAO exige chave de API. Nada a preencher aqui.

# Opcional: quantas respostas do Moderador Gemini podem ser geradas ao mesmo tempo
# na sala publica (protege a cota da API). Padrao: 3
GEMINI_MAX_SIMULTANEAS=3

# ---------- Segunda IA: Llama via Groq (Debate de IAs) ----------
# Gratis, sem cartao: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo da Groq (veja os disponiveis em https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Debate de IAs (opcionais) ----------
# Falas no total quando ninguem escolhe (padrao 8) e o maximo permitido (padrao 20)
DEBATE_TURNOS=8
DEBATE_TURNOS_MAX=20
# Segundos entre uma fala e outra (padrao 8, minimo 3) - tempo para ler
DEBATE_INTERVALO_SEGUNDOS=8

# ---------- CORS (vale para o Express E para o Socket.io) ----------
# Origens liberadas, separadas por virgula, sem barra no final.
# Localhost e 127.0.0.1 ja sao liberados automaticamente.
CORS_ORIGIN=https://seu-projeto.vercel.app

# ---------- Testes automatizados (somente na sua maquina) ----------
# Banco DESCARTAVEL usado por `npm test`. Ele e APAGADO a cada execucao.
# Nunca aponte para o banco de producao.
# MONGO_URI_TESTE=mongodb://127.0.0.1:27017/chatbot-teste
